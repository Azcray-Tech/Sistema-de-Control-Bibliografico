<!DOCTYPE html>
<html lang="es">
<head>
    <title><%= title %> - CEELA</title>
    <%- include('../partials/head') %>
    <script>if(localStorage.getItem('sidebarCollapsed')==='true'){document.documentElement.classList.add('sc')}</script>
    <style>html.sc .sidebar{width:75px}html.sc .sidebar,html.sc .sidebar *{transition:none!important}html.sc .main-content{margin-left:75px}html.sc .main-content,html.sc .main-content *{transition:none!important}</style>
    <%- typeof headStyles !== 'undefined' ? headStyles : '' %>
</head>
<body>
    <div class="admin-wrapper">
        <%- include('../partials/sidebar', {page: page}) %>
        <div class="main-content">
            <div class="top-bar">
                <div>
                    <h2><%- heading %></h2>
                    <% if (typeof subheading !== 'undefined' && subheading) { %>
                    <small class="text-muted"><%- subheading %></small>
                    <% } %>
                </div>
            </div>

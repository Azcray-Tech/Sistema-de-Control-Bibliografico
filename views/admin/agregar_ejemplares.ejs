<!DOCTYPE html>
<html lang="es">
<head><title>Agregar Ejemplares - CEELA</title><%- include('../partials/head') %></head>
<body>
<% if (success) { %>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    Swal.fire({ icon: 'success', title: 'Ejemplares agregados', text: 'Los ejemplares se agregaron correctamente.', showConfirmButton: true, confirmButtonText: 'Aceptar', confirmButtonColor: '#2c5f4f' });
  });
</script>
<% } else if (error) { %>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    Swal.fire({ icon: 'error', title: 'Error', text: '<%= error %>', showConfirmButton: true, confirmButtonText: 'Aceptar', confirmButtonColor: '#2c5f4f' });
  });
</script>
<% } %>
<div class="admin-wrapper">
    <%- include('../partials/sidebar', {page:'materiales'}) %>
    <div class="main-content">
        <div class="top-bar">
            <div><h2><i class="bi bi-plus-circle me-2"></i>Agregar Ejemplares</h2>
            <small class="text-muted">Añadir copias a: <strong><%= material.titulo %></strong></small></div>
        </div>
        <div class="content-card">
            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-body">
                            <h5 class="card-title"><i class="bi bi-info-circle me-2"></i>Información del Material</h5>
                            <table class="table table-sm">
                                <tr><td>Título</td><td><strong><%= material.titulo %></strong></td></tr>
                                <tr><td>Tipo</td><td><span class="badge bg-secondary"><%= material.tipo %></span></td></tr>
                                <tr><td>Ejemplares actuales</td><td><%= material.ejemplares ? material.ejemplares.length : 0 %></td></tr>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title"><i class="bi bi-tags me-2"></i>Nuevos Identificadores</h5>
                            <form method="POST" action="/admin/materiales/<%= material.idMaterial %>/ejemplares" x-data="{
                                ids: [],
                                nuevoId: '',
                                errorDuplicado: false,
                                agregar() {
                                    const val = this.nuevoId.trim();
                                    if (!val) return;
                                    if (this.ids.includes(val)) { this.errorDuplicado = true; setTimeout(() => this.errorDuplicado = false, 1500); return; }
                                    this.ids.push(val);
                                    this.nuevoId = '';
                                },
                                quitar(idx) { this.ids.splice(idx, 1); }
                            }">
                                <div class="input-group mb-3">
                                    <input type="text" class="form-control" x-model="nuevoId"
                                        @keydown.enter.prevent="agregar()"
                                        :class="errorDuplicado ? 'is-invalid' : ''"
                                        placeholder="Identificador único (ej: E-010)">
                                    <button class="btn btn-outline-success" type="button" @click="agregar()">
                                        <i class="bi bi-plus-lg"></i>
                                    </button>
                                </div>
                                <div class="d-flex flex-wrap gap-1 mb-3">
                                    <template x-for="(id, idx) in ids" :key="idx">
                                        <div class="d-flex align-items-center gap-1">
                                            <input type="hidden" name="identificadores" :value="id">
                                            <span class="badge bg-success py-1 px-2" style="font-size:.8rem;" x-text="id"></span>
                                            <button type="button" class="btn btn-sm btn-outline-danger px-1 py-0"
                                                @click="quitar(idx)" title="Quitar">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </div>
                                    </template>
                                </div>
                                <div class="text-muted small mb-3" x-show="ids.length > 0"
                                    x-text="'\u2713 ' + ids.length + ' ejemplar(es) nuevo(s)'"></div>
                                <div class="d-flex gap-2 justify-content-end">
                                    <a href="/admin/materiales" class="btn btn-secondary-custom">
                                        <i class="bi bi-x-lg me-2"></i>Cancelar
                                    </a>
                                    <button type="submit" class="btn btn-primary-custom">
                                        <i class="bi bi-save me-2"></i>Guardar Ejemplares
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</body>
</html>
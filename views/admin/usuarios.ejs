<%- include('../layouts/admin_start', {title:'Usuarios', page:'usuarios', heading:'<i class="bi bi-people me-2"></i>Usuarios del Sistema', subheading:'Gesti\u00f3n de cuentas de personal'}) %>
<% if (success === 'creado') { %>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    Swal.fire({ icon: 'success', title: 'Usuario creado', text: 'La cuenta de usuario se creó correctamente.', showConfirmButton: true, confirmButtonText: 'Aceptar', confirmButtonColor: '#2c5f4f' });
  });
</script>
<% } else if (success === 'desactivado') { %>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    Swal.fire({ icon: 'success', title: 'Usuario desactivado', text: 'El usuario fue desactivado correctamente.', showConfirmButton: true, confirmButtonText: 'Aceptar', confirmButtonColor: '#2c5f4f' });
  });
</script>
<% } else if (error) { %>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    Swal.fire({ icon: 'error', title: 'Error', text: '<%= error %>', showConfirmButton: true, confirmButtonText: 'Aceptar', confirmButtonColor: '#2c5f4f' });
  });
</script>
<% } %>
<div class="content-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><span class="text-muted">Total: <strong><%= usuarios.length %></strong> usuario(s)</span></div>
        <a href="/admin/usuarios/nuevo" class="btn btn-primary-custom btn-sm">
            <i class="bi bi-person-plus me-1"></i>Nuevo Usuario
        </a>
    </div>
    <div class="table-responsive">
        <table class="table table-custom table-sm">
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Nombre Completo</th>
                    <th>Cédula</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th>Fecha de Creación</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                <% usuarios.forEach(function(u) { %>
                <tr>
                    <td><code><%= u.nombreUsuario %></code></td>
                    <td><%= u.nombre %> <%= u.apellido %></td>
                    <td><%= u.cedula %></td>
                    <td>
                        <span class="badge <%= u.rol === 'Administrador' ? 'bg-dark' : 'bg-primary' %>">
                            <%= u.rol %>
                        </span>
                    </td>
                    <td>
                        <span class="badge <%= u.activo ? 'bg-success' : 'bg-secondary' %>">
                            <%= u.activo ? 'Activo' : 'Inactivo' %>
                        </span>
                    </td>
                    <td class="small"><%= new Date(u.createdAt).toLocaleDateString('es-VE') %></td>
                    <td>
                        <% if (u.activo && u.idUsuario !== usuarioSession.usuarioId) { %>
                        <button type="button" class="btn btn-sm btn-outline-danger btn-desactivar"
                            data-id="<%= u.idUsuario %>"
                            data-nombre="<%= u.nombre %> <%= u.apellido %>"
                            data-usuario="<%= u.nombreUsuario %>"
                            title="Desactivar">
                            <i class="bi bi-person-x"></i>
                        </button>
                        <form id="form-desactivar-<%= u.idUsuario %>" method="POST" action="/admin/usuarios/<%= u.idUsuario %>/desactivar" class="d-none"></form>
                        <% } else if (!u.activo) { %>
                        <span class="text-muted small">—</span>
                        <% } else { %>
                        <span class="text-muted small"><i class="bi bi-shield-check"></i> Tú</span>
                        <% } %>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>
<script>
$('.btn-desactivar').on('click', function() {
    let btn = $(this);
    let id = btn.data('id');
    let nombre = btn.data('nombre');
    let usuario = btn.data('usuario');
    Swal.fire({
        title: '¿Desactilet usuario?',
        html: 'Se desactivará la cuenta de <strong>"' + nombre + '" (' + usuario + ')</strong>.<br>El usuario no podrá iniciar sesión.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc3545',
        cancelButtonColor: '#6c757d',
        confirmButtonText: '<i class="bi bi-person-x me-2"></i>Desactivar',
        cancelButtonText: 'Cancelar',
        reverseButtons: true
    }).then(function(result) {
        if (result.isConfirmed) {
            $('#form-desactivar-' + id).submit();
        }
    });
});
</script>
<%- include('../layouts/admin_end') %>

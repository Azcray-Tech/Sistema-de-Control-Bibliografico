<!DOCTYPE html>
<html lang="es">
<head>
    <title>Configuración - CEELA</title><%- include('../partials/head') %>
</head>
<body>
    <div class="admin-wrapper">
        <%- include('../partials/sidebar', {page:'configuracion'}) %>
        <div class="main-content">
            <div class="top-bar">
                <div>
                    <h2><i class="bi bi-gear me-2"></i>Configuración del Sistema</h2>
                    <small class="text-muted">Parámetros globales que rigen el comportamiento del sistema</small>
                </div>
            </div>

            <div class="content-card">
                <form method="POST" action="/admin/configuracion">
                    <div class="row g-4">
                        <div class="col-lg-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-header bg-white border-bottom-0 pt-3 pb-0">
                                    <h6 class="fw-bold mb-0"><i class="bi bi-arrow-left-right me-2 text-primary"></i>Préstamos</h6>
                                    <small class="text-muted">Configuración relacionada con préstamos y renovaciones</small>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <label class="form-label fw-medium">Días de préstamo</label>
                                        <input type="number" name="dias_prestamo" class="form-control"
                                            value="<%= parametros.dias_prestamo || 7 %>" min="1" required>
                                        <small class="text-muted">Duración por defecto de un préstamo (días)</small>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-medium">Máximo de préstamos simultáneos</label>
                                        <input type="number" name="max_prestamos_simultaneos" class="form-control"
                                            value="<%= parametros.max_prestamos_simultaneos || 3 %>" min="1" required>
                                        <small class="text-muted">Cantidad máxima de préstamos activos por solicitante</small>
                                    </div>
                                    <div class="mb-0">
                                        <label class="form-label fw-medium">Renovaciones permitidas</label>
                                        <input type="number" name="renovaciones_permitidas" class="form-control"
                                            value="<%= parametros.renovaciones_permitidas || 1 %>" min="0" required>
                                        <small class="text-muted">Número de renovaciones permitidas por préstamo (0 = no permitir)</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-header bg-white border-bottom-0 pt-3 pb-0">
                                    <h6 class="fw-bold mb-0"><i class="bi bi-exclamation-triangle me-2 text-warning"></i>Sanciones</h6>
                                    <small class="text-muted">Configuración de sanciones por retraso</small>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <label class="form-label fw-medium">Factor de sanción</label>
                                        <input type="number" name="factor_sancion" class="form-control"
                                            value="<%= parametros.factor_sancion || 2 %>" min="1" required>
                                        <small class="text-muted">Días de suspensión por cada día de retraso</small>
                                    </div>
                                    <div class="mb-0">
                                        <label class="form-label fw-medium">Suspensión máxima (días)</label>
                                        <input type="number" name="suspension_maxima" class="form-control"
                                            value="<%= parametros.suspension_maxima || 30 %>" min="1" required>
                                        <small class="text-muted">Tope máximo de días de suspensión aplicable</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-header bg-white border-bottom-0 pt-3 pb-0">
                                    <h6 class="fw-bold mb-0"><i class="bi bi-clock me-2 text-info"></i>Sesión y Respaldos</h6>
                                    <small class="text-muted">Configuración de sesión y programación de backups</small>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <label class="form-label fw-medium">Tiempo de inactividad (minutos)</label>
                                        <input type="number" name="tiempo_inactividad" class="form-control"
                                            value="<%= parametros.tiempo_inactividad || 15 %>" min="1" required>
                                        <small class="text-muted">Minutos de inactividad antes del cierre automático de sesión</small>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-medium">Backup automático</label>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" role="switch"
                                                   id="backup_auto_habilitado" name="backup_auto_habilitado" value="1"
                                                   <%= parametros.backup_auto_habilitado === '1' ? 'checked' : '' %>>
                                            <label class="form-check-label" for="backup_auto_habilitado">Habilitado</label>
                                        </div>
                                        <small class="text-muted">Activa o desactiva la generación automática de backups</small>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-medium">Hora de backup automático</label>
                                        <input type="time" name="hora_backup_automatico" class="form-control"
                                            value="<%= parametros.hora_backup_automatico || '09:00' %>">
                                        <small class="text-muted">Hora del día para ejecutar el backup automático (HH:MM)</small>
                                    </div>
                                    <div class="mb-0">
                                        <label class="form-label fw-medium">Ruta de backup automático</label>
                                        <input type="text" name="ruta_backup_automatico" class="form-control"
                                            value="<%= parametros.ruta_backup_automatico || '' %>" placeholder="ej: D:\backups\">
                                        <small class="text-muted">Ruta absoluta en el servidor donde se guardarán los backups</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="card border-0 shadow-sm h-100" style="background: #f8fafd;">
                                <div class="card-body d-flex flex-column align-items-center justify-content-center text-center">
                                    <i class="bi bi-info-circle" style="font-size: 2rem; color: var(--color-primary);"></i>
                                    <p class="text-muted mt-2 mb-0" style="max-width: 300px;">
                                        Los parámetros se aplican a las nuevas operaciones. 
                                        Los préstamos y sanciones existentes no se modifican.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                        <button type="submit" class="btn btn-primary-custom px-4">
                            <i class="bi bi-check-lg me-1"></i>Guardar Configuración
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {
        <% if (typeof error !== 'undefined' && error) { %>
            Swal.fire({ icon: 'error', title: 'Error', text: '<%= error %>', confirmButtonText: 'Aceptar', confirmButtonColor: '#2c5f4f' });
        <% } else if (success === 'actualizado') { %>
            Swal.fire({ icon: 'success', title: 'Configuración actualizada', text: 'Los parámetros del sistema se han guardado correctamente.', confirmButtonText: 'Aceptar', confirmButtonColor: '#2c5f4f' });
        <% } %>
        });
    </script>
</body>
</html>

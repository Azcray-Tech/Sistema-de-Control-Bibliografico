<%- include('../layouts/admin_start', {title:'Historial', page:'historial', heading:'<i class="bi bi-clock-history me-2"></i>Historial de Préstamos', subheading:'Historial completo de préstamos'}) %>
<div class="content-card">
    <div class="mb-3 row g-2">
        <div class="col-md-4">
            <input type="text" id="filtro" class="form-control" placeholder="Filtrar por solicitante o material...">
        </div>
        <div class="col-md-3">
            <select id="filtroEstado" class="form-select">
                <option value="">Todos los estados</option>
                <option value="Activo">Activo</option>
                <option value="Devuelto">Devuelto</option>
                <option value="Vencido">Vencido</option>
            </select>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-custom" id="tablaHistorial">
            <thead>
                <tr>
                    <th>Solicitante</th>
                    <th>Cédula</th>
                    <th>Material</th>
                    <th>Préstamo</th>
                    <th>Devolución esperada</th>
                    <th>Devolución real</th>
                    <th>Estado</th>
                    <th>Retraso</th>
                    <th>Atendió</th>
                </tr>
            </thead>
            <tbody>
                <% prestamos.forEach(p => {
                const sol = p.Solicitante;
                const ej = p.Ejemplar;
                const mat = ej ? ej.Material : null;
                const prestamista = p.prestamista;
                const hoy = new Date();
                const prevista = new Date(p.fechaDevolucionPrevista);
                const retraso = p.fechaDevolucionReal
                    ? Math.max(0, Math.floor((new Date(p.fechaDevolucionReal) - prevista) / 86400000))
                    : Math.max(0, Math.floor((hoy - prevista) / 86400000));
                %>
                <tr data-estado="<%= p.estado %>">
                    <td><%= sol ? sol.nombre + ' ' + sol.apellido : '-' %></td>
                    <td><small><%= sol ? sol.cedula : '-' %></small></td>
                    <td><%= mat ? mat.titulo.substring(0,40) : '-' %></td>
                    <td><small><%= new Date(p.fechaPrestamo).toLocaleDateString('es-VE') %></small></td>
                    <td><small><%= new Date(p.fechaDevolucionPrevista).toLocaleDateString('es-VE') %></small></td>
                    <td><small><%= p.fechaDevolucionReal ? new Date(p.fechaDevolucionReal).toLocaleDateString('es-VE') : '-' %></small></td>
                    <td>
                        <% if (p.estado==='Activo') { %><span class="badge bg-success">Activo</span>
                        <% } else if (p.estado==='Devuelto') { %><span class="badge bg-primary">Devuelto</span>
                        <% } else { %><span class="badge bg-danger">Vencido</span><% } %>
                        <% if (p.renovaciones > 0) { %><small class="text-muted ms-1">(<%= p.renovaciones %> ren.)</small><% } %>
                    </td>
                    <td><%= retraso > 0 ? retraso+' días' : '-' %></td>
                    <td><small><%= prestamista ? prestamista.nombre + ' ' + prestamista.apellido : '-' %></small></td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>
<script>
document.getElementById('filtro').addEventListener('input', filtrar);
document.getElementById('filtroEstado').addEventListener('change', filtrar);

function filtrar() {
    const txt = document.getElementById('filtro').value.toLowerCase();
    const est = document.getElementById('filtroEstado').value;
    document.querySelectorAll('#tablaHistorial tbody tr').forEach(row => {
        const matchTxt = row.textContent.toLowerCase().includes(txt);
        const matchEst = !est || row.dataset.estado === est;
        row.style.display = matchTxt && matchEst ? '' : 'none';
    });
}
</script>
<%- include('../layouts/admin_end') %>

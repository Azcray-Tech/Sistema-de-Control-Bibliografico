<%- include('../layouts/admin_start', {title:'Nuevo Usuario', page:'usuarios', heading:'<i class="bi bi-person-plus me-2"></i>Nuevo Usuario', subheading:'Crear cuenta de personal del sistema'}) %>
<% if (typeof error !== 'undefined' && error) { %>
<div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i><%= error %></div>
<% } %>
<div class="form-container content-card">
    <form method="POST" action="/admin/usuarios" x-data="{ contrasena: '', contrasenaConfirmar: '', mostrarPass: false }">
        <div class="row g-4">
            <div class="col-lg-6">
                <h5 class="form-section-title"><i class="bi bi-person me-2"></i>Datos Personales</h5>
                <div class="mb-3">
                    <label class="form-label">Nombres <span class="text-danger">*</span></label>
                    <input type="text" name="nombre" class="form-control" required placeholder="Nombres completos">
                </div>
                <div class="mb-3">
                    <label class="form-label">Apellidos <span class="text-danger">*</span></label>
                    <input type="text" name="apellido" class="form-control" required placeholder="Apellidos completos">
                </div>
                <div class="mb-3">
                    <label class="form-label">Cédula <span class="text-danger">*</span></label>
                    <input type="text" name="cedula" class="form-control" required placeholder="V-12345678">
                </div>
            </div>
            <div class="col-lg-6">
                <h5 class="form-section-title"><i class="bi bi-key me-2"></i>Credenciales</h5>
                <div class="mb-3">
                    <label class="form-label">Nombre de Usuario <span class="text-danger">*</span></label>
                    <input type="text" name="nombreUsuario" class="form-control" required placeholder="ej: jperez">
                </div>
                <div class="mb-3">
                    <label class="form-label">Contraseña <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <input type="password" name="contrasena" class="form-control" required minlength="8"
                            x-model="contrasena" placeholder="Mínimo 8 caracteres">
                        <button type="button" class="btn btn-outline-secondary" @click="mostrarPass = !mostrarPass">
                            <i class="bi" :class="mostrarPass ? 'bi-eye-slash' : 'bi-eye'"></i>
                        </button>
                    </div>
                    <small class="form-text text-muted">Mínimo 8 caracteres</small>
                </div>
                <div class="mb-3">
                    <label class="form-label">Rol <span class="text-danger">*</span></label>
                    <select name="rol" class="form-select" required>
                        <option value="">Seleccione...</option>
                        <option value="Bibliotecario">Bibliotecario</option>
                        <option value="Administrador">Administrador</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="d-flex gap-3 justify-content-end mt-4">
            <a href="/admin/usuarios" class="btn btn-secondary-custom"><i class="bi bi-x-lg me-2"></i>Cancelar</a>
            <button type="submit" class="btn btn-primary-custom">
                <i class="bi bi-save me-2"></i>Crear Usuario
            </button>
        </div>
    </form>
</div>
<script>
document.addEventListener('DOMContentLoaded', function() {
    document.querySelector('[name="contrasena"]').addEventListener('input', function() {
        let btn = this.closest('.input-group').querySelector('button');
        if (this.value.length > 0 && this.value.length < 8) {
            this.classList.add('is-invalid');
        } else {
            this.classList.remove('is-invalid');
        }
    });
});
</script>
<%- include('../layouts/admin_end') %>

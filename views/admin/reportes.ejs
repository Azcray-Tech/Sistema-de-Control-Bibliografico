<%- include('../layouts/admin_start', {title:'Reportes', page:'reportes', heading:'Generar Reportes', subheading: new Date().toLocaleDateString('es-VE', {weekday:'long', year:'numeric', month:'long', day:'numeric'}) + ' \u00B7 ' + usuarioSession.nombre}) %>

<% if (error) { %>
<div class="alert alert-danger alert-dismissible fade show"><%= error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
<% } %>

<div class="content-card">
<div class="list-group list-group-flush rounded-3 overflow-hidden" style="border:1px solid rgba(0,0,0,0.06);">

  <!-- RF-31: Inventario -->
  <form action="/admin/reportes/inventario" method="POST" class="list-group-item bg-white border-bottom py-3 px-4">
    <div class="row align-items-center g-2">
      <div class="col-md-4 col-lg-4">
        <div class="d-flex align-items-center gap-3">
          <span class="report-row-icon">
            <i class="bi bi-box-seam"></i>
          </span>
          <div>
            <h6 class="fw-bold mb-0" style="font-family:'Libre Baskerville',serif;font-size:0.95rem;">Inventario Completo</h6>
            <small class="text-muted">Materiales con metadatos, ejemplares y disponibles</small>
          </div>
        </div>
      </div>
      <div class="col-md-5 col-lg-5">
        <div class="d-flex flex-wrap align-items-center gap-1">
          <div class="input-group input-group-sm" style="width:auto;">
            <span class="input-group-text">Tipo</span>
            <select name="tipo" class="form-select" style="min-width:110px;">
              <option value="">Todos</option>
              <option value="libro">Libro</option>
              <option value="revista">Revista</option>
              <option value="tesis">Tesis</option>
              <option value="anuario">Anuario</option>
            </select>
          </div>
          <div class="input-group input-group-sm" style="width:auto;">
            <span class="input-group-text">Categoría</span>
            <select name="categoriaId" class="form-select" style="min-width:130px;">
              <option value="">Todas</option>
              <% (categorias || []).forEach(c => { %>
              <option value="<%= c.idCategoria %>"><%= c.nombre %></option>
              <% }) %>
            </select>
          </div>
        </div>
      </div>
      <div class="col-md-3 col-lg-3 text-end">
        <div class="dropdown d-inline-block">
          <button class="btn btn-sm btn-excel dropdown-toggle" type="button" data-bs-toggle="dropdown">
            <i class="bi bi-download me-1"></i>Generar Reporte
          </button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><button type="submit" name="formato" value="pdf" class="dropdown-item"><i class="bi bi-file-earmark-pdf me-2"></i>Exportar como PDF</button></li>
            <li><button type="submit" name="formato" value="excel" class="dropdown-item"><i class="bi bi-file-earmark-excel me-2"></i>Exportar como Excel</button></li>
          </ul>
        </div>
      </div>
    </div>
  </form>

  <!-- RF-32: Préstamos Activos -->
  <form action="/admin/reportes/prestamos-activos" method="POST" class="list-group-item bg-light border-bottom py-3 px-4">
    <div class="row align-items-center g-2">
      <div class="col-md-4 col-lg-4">
        <div class="d-flex align-items-center gap-3">
          <span class="report-row-icon">
            <i class="bi bi-arrow-left-right"></i>
          </span>
          <div>
            <h6 class="fw-bold mb-0" style="font-family:'Libre Baskerville',serif;font-size:0.95rem;">Préstamos Activos</h6>
            <small class="text-muted">Préstamos activos con resaltado de vencidos</small>
          </div>
        </div>
      </div>
      <div class="col-md-5 col-lg-5">
        <div class="d-flex flex-wrap align-items-center gap-1">
          <div class="input-group input-group-sm" style="width:auto;">
            <span class="input-group-text">Filtro</span>
            <select name="soloVencidos" class="form-select" style="min-width:185px;">
              <option value="">Todos los préstamos activos</option>
              <option value="true">Solo vencidos</option>
            </select>
          </div>
        </div>
      </div>
      <div class="col-md-3 col-lg-3 text-end">
        <div class="dropdown d-inline-block">
          <button class="btn btn-sm btn-excel dropdown-toggle" type="button" data-bs-toggle="dropdown">
            <i class="bi bi-download me-1"></i>Generar Reporte
          </button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><button type="submit" name="formato" value="pdf" class="dropdown-item"><i class="bi bi-file-earmark-pdf me-2"></i>Exportar como PDF</button></li>
            <li><button type="submit" name="formato" value="excel" class="dropdown-item"><i class="bi bi-file-earmark-excel me-2"></i>Exportar como Excel</button></li>
          </ul>
        </div>
      </div>
    </div>
  </form>

  <!-- RF-33: Historial por Solicitante -->
  <form action="/admin/reportes/historial-solicitante" method="POST" class="list-group-item bg-white border-bottom py-3 px-4">
    <div class="row align-items-center g-2">
      <div class="col-md-4 col-lg-4">
        <div class="d-flex align-items-center gap-3">
          <span class="report-row-icon">
            <i class="bi bi-clock-history"></i>
          </span>
          <div>
            <h6 class="fw-bold mb-0" style="font-family:'Libre Baskerville',serif;font-size:0.95rem;">Historial por Solicitante</h6>
            <small class="text-muted">Préstamos y sanciones de un solicitante</small>
          </div>
        </div>
      </div>
      <div class="col-md-5 col-lg-5">
        <div class="d-flex flex-wrap align-items-center gap-1">
          <div class="input-group input-group-sm" style="width:auto;">
            <span class="input-group-text">Cédula</span>
            <input type="text" name="cedula" class="form-control" placeholder="Ingrese la cédula" style="min-width:140px;" required>
          </div>
        </div>
      </div>
      <div class="col-md-3 col-lg-3 text-end">
        <div class="dropdown d-inline-block">
          <button class="btn btn-sm btn-excel dropdown-toggle" type="button" data-bs-toggle="dropdown">
            <i class="bi bi-download me-1"></i>Generar Reporte
          </button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><button type="submit" name="formato" value="pdf" class="dropdown-item"><i class="bi bi-file-earmark-pdf me-2"></i>Exportar como PDF</button></li>
            <li><button type="submit" name="formato" value="excel" class="dropdown-item"><i class="bi bi-file-earmark-excel me-2"></i>Exportar como Excel</button></li>
          </ul>
        </div>
      </div>
    </div>
  </form>

  <!-- RF-34: Ranking -->
  <form action="/admin/reportes/ranking" method="POST" class="list-group-item bg-light border-bottom py-3 px-4">
    <div class="row align-items-center g-2">
      <div class="col-md-4 col-lg-4">
        <div class="d-flex align-items-center gap-3">
          <span class="report-row-icon">
            <i class="bi bi-trophy"></i>
          </span>
          <div>
            <h6 class="fw-bold mb-0" style="font-family:'Libre Baskerville',serif;font-size:0.95rem;">Ranking de Materiales</h6>
            <small class="text-muted">Más prestados por período</small>
          </div>
        </div>
      </div>
      <div class="col-md-5 col-lg-5">
        <div class="d-flex flex-wrap align-items-center gap-1">
          <div class="input-group input-group-sm" style="width:auto;">
            <span class="input-group-text">Período</span>
            <select name="periodo" class="form-select" style="min-width:140px;">
              <option value="">Todo el historial</option>
              <option value="mes">Último mes</option>
              <option value="anio">Último año</option>
            </select>
          </div>
          <div class="input-group input-group-sm" style="width:auto;">
            <span class="input-group-text">Top</span>
            <select name="topN" class="form-select" style="min-width:95px;">
              <option value="">Todos</option>
              <option value="5">Top 5</option>
              <option value="10" selected>Top 10</option>
              <option value="20">Top 20</option>
              <option value="50">Top 50</option>
            </select>
          </div>
        </div>
      </div>
      <div class="col-md-3 col-lg-3 text-end">
        <div class="dropdown d-inline-block">
          <button class="btn btn-sm btn-excel dropdown-toggle" type="button" data-bs-toggle="dropdown">
            <i class="bi bi-download me-1"></i>Generar Reporte
          </button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><button type="submit" name="formato" value="pdf" class="dropdown-item"><i class="bi bi-file-earmark-pdf me-2"></i>Exportar como PDF</button></li>
            <li><button type="submit" name="formato" value="excel" class="dropdown-item"><i class="bi bi-file-earmark-excel me-2"></i>Exportar como Excel</button></li>
          </ul>
        </div>
      </div>
    </div>
  </form>

  <!-- RF-35: Vencidos con Contacto -->
  <form action="/admin/reportes/vencidos-contacto" method="POST" class="list-group-item bg-white border-bottom py-3 px-4">
    <div class="row align-items-center g-2">
      <div class="col-md-4 col-lg-4">
        <div class="d-flex align-items-center gap-3">
          <span class="report-row-icon">
            <i class="bi bi-telephone"></i>
          </span>
          <div>
            <h6 class="fw-bold mb-0" style="font-family:'Libre Baskerville',serif;font-size:0.95rem;">Préstamos Vencidos con Contacto</h6>
            <small class="text-muted">Vencidos con datos del solicitante</small>
          </div>
        </div>
      </div>
      <div class="col-md-5 col-lg-5">
        <div class="d-flex flex-wrap align-items-center gap-1">
          <div class="input-group input-group-sm" style="width:auto;">
            <span class="input-group-text">Vencidos hace</span>
            <select name="diasMinimo" class="form-select" style="min-width:170px;">
              <option value="">Todos los vencidos</option>
              <option value="1">1 día</option>
              <option value="5">5 días</option>
              <option value="10">10 días</option>
              <option value="30">30 días</option>
            </select>
          </div>
        </div>
      </div>
      <div class="col-md-3 col-lg-3 text-end">
        <div class="dropdown d-inline-block">
          <button class="btn btn-sm btn-excel dropdown-toggle" type="button" data-bs-toggle="dropdown">
            <i class="bi bi-download me-1"></i>Generar Reporte
          </button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><button type="submit" name="formato" value="pdf" class="dropdown-item"><i class="bi bi-file-earmark-pdf me-2"></i>Exportar como PDF</button></li>
            <li><button type="submit" name="formato" value="excel" class="dropdown-item"><i class="bi bi-file-earmark-excel me-2"></i>Exportar como Excel</button></li>
          </ul>
        </div>
      </div>
    </div>
  </form>

  <!-- RF-36: Estadísticas -->
  <form action="/admin/reportes/estadisticas" method="POST" class="list-group-item bg-light border-bottom py-3 px-4">
    <div class="row align-items-center g-2">
      <div class="col-md-4 col-lg-4">
        <div class="d-flex align-items-center gap-3">
          <span class="report-row-icon">
            <i class="bi bi-pie-chart"></i>
          </span>
          <div>
            <h6 class="fw-bold mb-0" style="font-family:'Libre Baskerville',serif;font-size:0.95rem;">Estadísticas por Categoría y Tipo</h6>
            <small class="text-muted">Préstamos agrupados en un período</small>
          </div>
        </div>
      </div>
      <div class="col-md-5 col-lg-5">
        <div class="d-flex flex-wrap align-items-center gap-1">
          <div class="input-group input-group-sm" style="width:auto;">
            <span class="input-group-text">Desde</span>
            <input type="date" name="fechaDesde" class="form-control" style="min-width:135px;" required>
          </div>
          <div class="input-group input-group-sm" style="width:auto;">
            <span class="input-group-text">Hasta</span>
            <input type="date" name="fechaHasta" class="form-control" style="min-width:135px;" required>
          </div>
        </div>
      </div>
      <div class="col-md-3 col-lg-3 text-end">
        <div class="dropdown d-inline-block">
          <button class="btn btn-sm btn-excel dropdown-toggle" type="button" data-bs-toggle="dropdown">
            <i class="bi bi-download me-1"></i>Generar Reporte
          </button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><button type="submit" name="formato" value="pdf" class="dropdown-item"><i class="bi bi-file-earmark-pdf me-2"></i>Exportar como PDF</button></li>
            <li><button type="submit" name="formato" value="excel" class="dropdown-item"><i class="bi bi-file-earmark-excel me-2"></i>Exportar como Excel</button></li>
          </ul>
        </div>
      </div>
    </div>
  </form>

  <!-- RF-37: Suspendidos -->
  <form action="/admin/reportes/suspendidos" method="POST" class="list-group-item bg-white py-3 px-4">
    <div class="row align-items-center g-2">
      <div class="col-md-4 col-lg-4">
        <div class="d-flex align-items-center gap-3">
          <span class="report-row-icon">
            <i class="bi bi-exclamation-triangle"></i>
          </span>
          <div>
            <h6 class="fw-bold mb-0" style="font-family:'Libre Baskerville',serif;font-size:0.95rem;">Solicitantes Suspendidos</h6>
            <small class="text-muted">Suspensiones activas, tipo y motivo</small>
          </div>
        </div>
      </div>
      <div class="col-md-5 col-lg-5">
        <div class="d-flex flex-wrap align-items-center gap-1">
          <div class="input-group input-group-sm" style="width:auto;">
            <span class="input-group-text">Tipo</span>
            <select name="tipoSuspension" class="form-select" style="min-width:185px;">
              <option value="">Todos los suspendidos</option>
              <option value="temporal">Suspensión temporal</option>
              <option value="permanente">Suspensión permanente</option>
            </select>
          </div>
        </div>
      </div>
      <div class="col-md-3 col-lg-3 text-end">
        <div class="dropdown d-inline-block">
          <button class="btn btn-sm btn-excel dropdown-toggle" type="button" data-bs-toggle="dropdown">
            <i class="bi bi-download me-1"></i>Generar Reporte
          </button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><button type="submit" name="formato" value="pdf" class="dropdown-item"><i class="bi bi-file-earmark-pdf me-2"></i>Exportar como PDF</button></li>
            <li><button type="submit" name="formato" value="excel" class="dropdown-item"><i class="bi bi-file-earmark-excel me-2"></i>Exportar como Excel</button></li>
          </ul>
        </div>
      </div>
    </div>
  </form>

</div>
</div>
<%- include('../layouts/admin_end') %>

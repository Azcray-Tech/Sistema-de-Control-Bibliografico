<!DOCTYPE html>
<html lang="es">
<head><title>Ejemplares - CEELA</title><%- include('../partials/head') %></head>
<body>
<% if (success === 'creado') { %>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    Swal.fire({ icon: 'success', title: 'Ejemplares agregados', text: 'Los ejemplares se agregaron correctamente.', showConfirmButton: true, confirmButtonText: 'Aceptar', confirmButtonColor: '#2c5f4f' });
  });
</script>
<% } else if (success === 'actualizado') { %>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    Swal.fire({ icon: 'success', title: 'Estado actualizado', text: 'El estado del ejemplar se actualizó correctamente.', showConfirmButton: true, confirmButtonText: 'Aceptar', confirmButtonColor: '#2c5f4f' });
  });
</script>
<% } else if (error) { %>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    Swal.fire({ icon: 'error', title: 'Error', text: '<%= error %>', showConfirmButton: true, confirmButtonText: 'Aceptar', confirmButtonColor: '#2c5f4f' });
  });
</script>
<% } %>
<div class="admin-wrapper">
    <%- include('../partials/sidebar', {page:'materiales'}) %>
    <div class="main-content">
        <div class="top-bar">
            <div><h2><i class="bi bi-boxes me-2"></i>Ejemplares</h2>
            <small class="text-muted">Gestión de ejemplares de: <strong><%= material.titulo %></strong></small></div>
        </div>
        <div class="content-card">
            <div class="section-header d-flex align-items-center gap-4 flex-wrap">
                <div style="width:60px;flex-shrink:0;">
                    <img src="/images/covers/<%= material.portada || 'default.jpg' %>"
                        style="width:60px;height:80px;object-fit:cover;border-radius:6px;box-shadow:var(--shadow-sm);">
                </div>
                <div class="flex-grow-1" style="min-width:200px;">
                    <h5 class="mb-1" style="font-family:'Libre Baskerville',serif;"><%= material.titulo %></h5>
                    <div class="d-flex flex-wrap gap-4 mt-2">
                        <div>
                            <div class="info-label">Tipo</div>
                            <div><span class="badge bg-secondary"><%= material.tipo.charAt(0).toUpperCase() + material.tipo.slice(1) %></span></div>
                        </div>
                        <div>
                            <div class="info-label">Signatura</div>
                            <div class="info-valor" style="font-size:.9rem;"><%= material.signatura || '—' %></div>
                        </div>
                        <div>
                            <div class="info-label">Categoría</div>
                            <div class="info-valor" style="font-size:.9rem;"><%= material.Categorium ? material.Categorium.nombre : '—' %></div>
                        </div>
                    </div>
                </div>
                <div class="text-end flex-shrink-0">
                    <div class="info-label">Total Ejemplares</div>
                    <div class="info-valor" style="font-size:1.5rem;"><%= ejemplares.length %></div>
                    <div class="mt-1 d-flex gap-1 justify-content-end">
                        <span class="badge bg-success"><%= ejemplares.filter(e => e.estado === 'Disponible').length %> disp.</span>
                        <span class="badge bg-warning text-dark"><%= ejemplares.filter(e => e.estado === 'Prestado').length %> prest.</span>
                    </div>
                </div>
            </div>

            <h5 class="form-section-title mt-4"><i class="bi bi-plus-circle me-2"></i>Agregar Nuevos Ejemplares</h5>
            <div class="card border-0 shadow-sm mb-4" style="background:var(--color-bg-light);">
                <div class="card-body">
                    <form method="POST" action="/admin/materiales/<%= material.idMaterial %>/ejemplares" x-data="{
                        ids: [],
                        nuevoId: '',
                        errorDuplicado: false,
                        agregar() {
                            const val = this.nuevoId.trim();
                            if (!val) return;
                            if (this.ids.includes(val)) { this.errorDuplicado = true; setTimeout(() => this.errorDuplicado = false, 1500); return; }
                            this.ids.push(val);
                            this.nuevoId = '';
                        },
                        quitar(idx) { this.ids.splice(idx, 1); }
                    }">
                        <div class="row g-3 align-items-end">
                            <div class="col-md-6">
                                <label class="form-label">Identificador único</label>
                                <div class="input-group">
                                    <input type="text" class="form-control" x-model="nuevoId"
                                        @keydown.enter.prevent="agregar()"
                                        :class="errorDuplicado ? 'is-invalid' : ''"
                                        placeholder="ej: E-010">
                                    <button class="btn btn-outline-success" type="button" @click="agregar()">
                                        <i class="bi bi-plus-lg"></i>
                                    </button>
                                </div>
                                <div class="form-text">Presione Enter o el botón + para agregar cada identificador.</div>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex flex-wrap gap-1 mb-2" style="min-height:36px;">
                                    <template x-for="(id, idx) in ids" :key="idx">
                                        <div class="d-flex align-items-center gap-1">
                                            <input type="hidden" name="identificadores" :value="id">
                                            <span class="badge bg-success py-1 px-2" style="font-size:.8rem;" x-text="id"></span>
                                            <button type="button" class="btn btn-sm btn-outline-danger px-1 py-0"
                                                @click="quitar(idx)" title="Quitar">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </div>
                                    </template>
                                    <span class="text-muted small align-self-center" x-show="ids.length === 0"><i class="bi bi-info-circle me-1"></i>No hay identificadores agregados</span>
                                </div>
                                <div class="text-muted small mb-2" x-show="ids.length > 0"
                                    x-text="'\u2713 ' + ids.length + ' ejemplar(es) nuevo(s)'"></div>
                            </div>
                        </div>
                        <div class="d-flex gap-2 justify-content-end mt-3">
                            <button type="submit" class="btn btn-primary-custom" x-show="ids.length > 0">
                                <i class="bi bi-save me-2"></i>Guardar Ejemplares
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <h5 class="form-section-title"><i class="bi bi-list-ul me-2"></i>Listado de Ejemplares</h5>
            <div class="table-responsive">
                <table class="table table-custom">
                    <thead>
                        <tr>
                            <th style="width:50px;">#</th>
                            <th>Identificador</th>
                            <th style="width:140px;">Estado Actual</th>
                            <th>Cambiar Estado</th>
                            <th style="width:100px;">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (ejemplares.length === 0) { %>
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                <i class="bi bi-inbox" style="font-size:2rem;display:block;margin-bottom:.5rem;"></i>
                                Este material no tiene ejemplares registrados.
                            </td>
                        </tr>
                        <% } else { %>
                        <% ejemplares.forEach(function(ej, idx) { %>
                        <tr>
                            <td class="text-muted"><%= idx + 1 %></td>
                            <td><code><%= ej.identificadorUnico %></code></td>
                            <td>
                                <span class="badge <%= 
                                    ej.estado === 'Disponible' ? 'bg-success' : 
                                    ej.estado === 'Prestado' ? 'bg-warning text-dark' : 
                                    ej.estado === 'Dañado' ? 'bg-danger' : 
                                    ej.estado === 'Perdido' ? 'bg-dark' : 
                                    ej.estado === 'En restauración' ? 'bg-info text-dark' : 
                                    'bg-secondary' %>">
                                    <%= ej.estado %>
                                </span>
                            </td>
                            <td>
                                <% if (ej.estado === 'Prestado') { %>
                                    <span class="text-muted small"><i class="bi bi-lock me-1"></i>Debe devolverse primero</span>
                                <% } else if (ej.estado === 'Dado de baja') { %>
                                    <span class="text-muted small"><i class="bi bi-lock me-1"></i>Ejemplar dado de baja</span>
                                <% } else { %>
                                    <form method="POST" action="/admin/materiales/<%= material.idMaterial %>/ejemplares/<%= ej.idEjemplar %>/cambiar-estado"
                                        class="d-flex align-items-center gap-2">
                                        <input type="hidden" name="materialId" value="<%= material.idMaterial %>">
                                        <select name="estado" class="form-select form-select-sm" style="width:auto;min-width:130px;">
                                            <% let estadosPermitidos = ['Disponible', 'En restauración', 'Dañado', 'Perdido']; %>
                                            <% if (usuarioSession.rol === 'Administrador') { estadosPermitidos.push('Dado de baja'); } %>
                                            <% estadosPermitidos.forEach(function(est) { %>
                                            <option value="<%= est %>" <%= ej.estado === est ? 'selected' : '' %>><%= est %></option>
                                            <% }) %>
                                        </select>
                                        <input type="text" name="motivo" class="form-control form-control-sm" style="width:140px;" placeholder="Motivo">
                                        <button type="submit" class="btn btn-sm btn-outline-primary" title="Cambiar estado"><i class="bi bi-check-lg"></i></button>
                                    </form>
                                <% } %>
                            </td>
                            <td class="text-center">
                                <span class="small text-muted">#<%= ej.idEjemplar %></span>
                            </td>
                        </tr>
                        <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center mt-4">
                <a href="/admin/materiales" class="btn btn-secondary-custom btn-sm">
                    <i class="bi bi-arrow-left me-1"></i>Volver al catálogo
                </a>
                <small class="text-muted">Total: <strong><%= ejemplares.length %></strong> ejemplar(es)</small>
            </div>
        </div>
    </div>
</div>
</body>
</html>

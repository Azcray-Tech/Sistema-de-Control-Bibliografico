{
  "name": "sistema-control-bibliografico",
  "version": "1.0.0",
  "description": "Sistema de Control Bibliográfico - CEELA",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "eslint .",
    "test": "jest --passWithNoTests --no-cache",
    "test:coverage": "jest --passWithNoTests --coverage --coverageDirectory=reports/coverage --no-cache",
    "test:watch": "jest --watch --passWithNoTests",
    "test:e2e": "node scripts/create_test_db.js && jest --config jest.e2e.config.js --runInBand --forceExit",
    "test:integration": "node scripts/create_test_db.js && jest --config jest.integration.config.js --runInBand --forceExit",
    "test:stress": "echo 'Usar: npx artillery run tests/stress/ceela-<escenario>.yml'",
    "benchmark:session": "node tests/benchmark-session.js",
    "metrics": "node scripts/metrics.js",
    "metrics:coverage": "jest --passWithNoTests --coverage --coverageDirectory=reports/coverage --no-cache",
    "metrics:lint": "eslint . -f html -o reports/lint.html",
    "metrics:dup": "npx jscpd . --output reports/duplication --min-lines 5 --min-tokens 50 --reporters console,json --format javascript,json,sql --ignore-pattern \"node_modules/**,reports/**,public/js/**,tests/**,package-lock.json\"",
    "metrics:ccn": "node scripts/complexity.js",
    "metrics:all": "node scripts/metrics.js"
  },
  "overrides": {
    "lodash": "4.17.21",
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "archiver": "^6.0.1",
    "bcryptjs": "^2.4.3",
    "code-health-meter": "^4.1.2",
    "connect-flash": "^0.1.1",
    "connect-session-sequelize": "^7.1.7",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.17.3",
    "extract-zip": "^2.0.1",
    "isbn-validate": "^1.0.3",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.5",
    "node-cron": "^4.2.1",
    "pdfkit": "^0.13.0",
    "sequelize": "^6.35.0",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "artillery": "^2.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "jest": "^30.4.2",
    "jscpd": "^5.0.5",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2",
    "typhonjs-escomplex": "^0.1.0"
  }
}
